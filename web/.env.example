# web/.env.local is generated by `pnpm sync-env` from contracts/.env. Testnet-only keys.
# localhost (Hardhat test mnemonic, no keys needed) or sepolia
NETWORK=localhost
# Optional RPC override (localhost default http://127.0.0.1:8545; Sepolia falls back across public RPCs)
RPC_URL=
# Optional: live AI extraction. Without it, labelled sample outputs are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Verifier ML-DSA-65 seed (32 bytes hex)
VERIFIER_PQ_SEED=
# Demo role keys (Sepolia only). On Sepolia, a role without a key is read-only (address from deployments.json).
DEPLOYER_PRIVATE_KEY=
PRODUCER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
IMPORTER_A_PRIVATE_KEY=
IMPORTER_B_PRIVATE_KEY=
# Pig-iron supplier (only the seed script signs as the supplier)
SUPPLIER_PRIVATE_KEY=
